<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RetroPlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/retro_background</item>
        <item name="android:colorBackground">@color/retro_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>

    <!-- Tela de jogo: preta, sem barras, sem animação de janela. -->
    <style name="Theme.RetroPlay.Game" parent="Theme.RetroPlay">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Splash curta (core-splashscreen): fica só enquanto a primeira tela é composta. -->
    <style name="Theme.RetroPlay.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/retro_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.RetroPlay</item>
    </style>
</resources>
