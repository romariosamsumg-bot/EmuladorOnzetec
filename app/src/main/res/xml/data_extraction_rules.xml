<?xml version="1.0" encoding="utf-8"?>
<!-- Zero coleta de dados: nada vai para backup em nuvem nem transferência entre aparelhos.
     O backup de saves é feito pelo próprio app, para um pendrive (Fase 9). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
