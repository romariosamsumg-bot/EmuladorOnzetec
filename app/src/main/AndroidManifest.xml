<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Download de núcleos e capas. Nenhum dado do usuário é enviado. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Ler a pasta "Jogos" e outras pastas escolhidas. Android 11+: "acesso a todos os arquivos"
         (o app é distribuído por APK, fora da Play Store). Android 8-10: permissões clássicas. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Toque e gamepad são opcionais (a TV não tem toque; o celular pode não ter gamepad).
         O app de TV declara o leanback no manifesto do sabor "tv". -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Telas das Configurações usadas no guia de permissão (visibilidade de pacotes, Android 11+). -->
    <queries>
        <intent><action android:name="android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.MANAGE_ALL_FILES_ACCESS_PERMISSION" /></intent>
        <intent><action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" /><data android:scheme="package" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>

    <application
        android:name=".RetroPlayApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="false"
        android:theme="@style/Theme.RetroPlay.Splash">

        <!-- configChanges inclui keyboard/navigation: conectar um gamepad Bluetooth
             não pode recriar a Activity (perderia o estado do jogo). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Jogo em processo separado: libera RAM da UI e isola falhas do núcleo nativo. -->
        <activity
            android:name=".feature.game.GameActivity"
            android:exported="false"
            android:process=":game"
            android:theme="@style/Theme.RetroPlay.Game"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale" />

        <!-- WorkManager com HiltWorkerFactory: remove o inicializador automático. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
